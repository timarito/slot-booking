{
  "name": "slot-booking",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "api:dev": "pnpm --filter @slot-booking/api start:dev",
    "api:build": "pnpm --filter @slot-booking/api build",
    "web:dev": "pnpm --filter @slot-booking/web dev",
    "web:build": "pnpm --filter @slot-booking/web build",
    "openapi:generate": "pnpm --filter @slot-booking/api openapi:export && pnpm --filter @slot-booking/web openapi:types",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
