# Скопируй в .env (он в .gitignore). Переменные VITE_* вшиваются в бандл при сборке —
# это публичная конфигурация, не секреты.

# Адрес API. Должен совпадать с портом apps/api (PORT), а origin этого приложения —
# с CORS_ORIGIN в apps/api/.env, иначе браузер заблокирует ответы.
VITE_API_URL=http://localhost:3000
