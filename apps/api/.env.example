# Скопируй в .env и поправь под себя. .env в .gitignore; этот файл документирует все переменные,
# которые нужны приложению.

NODE_ENV=development
PORT=3000

# Должны совпадать с учётными данными в корневом docker-compose.yml.
DATABASE_URL=postgresql://slot_booking:slot_booking@localhost:5432/slot_booking

# Точный origin веб-приложения (dev-сервер Vite). Без wildcard: cookie отправляются cross-origin.
CORS_ORIGIN=http://localhost:5173

# Секрет подписи access-токенов, минимум 32 символа. Для каждого окружения свой, случайный:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=

# Необязательно. Время жизни access-токена (минуты) и refresh-токена (дни).
# JWT_ACCESS_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30

# Необязательно. Уровень логов pino: fatal | error | warn | info | debug | trace | silent.
# По умолчанию зависит от NODE_ENV: development -> debug, test -> silent, production -> info.
# LOG_LEVEL=debug
