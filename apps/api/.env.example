# Copy to .env and adjust. .env is git-ignored; this file documents every variable the app needs.

NODE_ENV=development
PORT=3000

# Must match the credentials in the root docker-compose.yml.
DATABASE_URL=postgresql://slot_booking:slot_booking@localhost:5432/slot_booking

# Exact origin of the web app (Vite dev server). No wildcards: cookies are sent cross-origin.
CORS_ORIGIN=http://localhost:5173
