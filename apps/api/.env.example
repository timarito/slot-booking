# Скопируй в .env и поправь под себя. .env в .gitignore; этот файл документирует все переменные,
# которые нужны приложению.

NODE_ENV=development
PORT=3000

# Должны совпадать с учётными данными в корневом docker-compose.yml.
DATABASE_URL=postgresql://slot_booking:slot_booking@localhost:5432/slot_booking

# Точный origin веб-приложения (dev-сервер Vite). Без wildcard: cookie отправляются cross-origin.
CORS_ORIGIN=http://localhost:5173
