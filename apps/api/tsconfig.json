{
  "compilerOptions": {
    // Node ESM: imports of local files need the ".js" extension (resolved after compilation).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "strict": true,
    // NestJS DI reads constructor parameter types at runtime via decorator metadata.
    // Without these two flags `constructor(private config: ConfigService)` would not be injected.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // DTO/entity classes get their fields from decorators/frameworks, not constructors.
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "types": ["node"]
  },
  // test/ and vitest configs are included so typecheck and type-aware linting cover them;
  // the build (tsconfig.build.json) still compiles src/ only.
  "include": ["src", "test", "prisma.config.ts", "vitest.config*.ts"]
}
