{
  "compilerOptions": {
    // Node ESM: импорты локальных файлов требуют расширения ".js" (разрешаются после компиляции).
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "strict": true,
    // DI в NestJS читает типы параметров конструктора в рантайме через метаданные декораторов.
    // Без этих двух флагов `constructor(private config: ConfigService)` не будет внедрён.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Поля DTO и сущностей заполняют декораторы и фреймворки, а не конструкторы.
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "types": ["node"]
  },
  // test/ и конфиги vitest включены, чтобы typecheck и type-aware линтинг их покрывали;
  // сборка (tsconfig.build.json) по-прежнему компилирует только src/.
  "include": ["src", "test", "prisma.config.ts", "vitest.config*.ts"]
}
