// Схема БД — единое описание таблиц, из которого Prisma генерирует SQL-миграции
// и типизированный клиент. Модели (User, Resource, Booking...) добавляются по вехам,
// начиная с M2 (аутентификация). См. docs/spec.md, раздел 3.

generator client {
  // "prisma-client" — генератор Prisma 7: обычный TS-код в нашем дереве исходников,
  // вместо старой скрытой папки node_modules/.prisma.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // URL подключения задаётся в prisma.config.ts (для CLI) и в PrismaService (в рантайме).
  provider = "postgresql"
}
