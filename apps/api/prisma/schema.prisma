// Схема БД — единое описание таблиц, из которого Prisma генерирует SQL-миграции
// и типизированный клиент. Модели (User, Resource, Booking...) добавляются по вехам,
// начиная с M2 (аутентификация). См. docs/spec.md, раздел 3.

generator client {
  // "prisma-client" — генератор Prisma 7: обычный TS-код в нашем дереве исходников,
  // вместо старой скрытой папки node_modules/.prisma.
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // URL подключения задаётся в prisma.config.ts (для CLI) и в PrismaService (в рантайме).
  provider = "postgresql"
}

// Соглашения для всех моделей:
// - В БД имена в snake_case и таблицы во множественном числе (@map/@@map): Postgres приводит
//   неквотированные имена к нижнему регистру, и ручной SQL (CHECK, EXCLUDE) пишется без кавычек.
// - id — UUID v7: неугадываемый (нельзя перебрать соседние id), но растёт по времени, поэтому
//   вставки идут в конец B-tree индекса PK. Тип uuid (16 байт), а не text.
// - Время — только @db.Timestamptz(3): без этого Prisma создаёт timestamp БЕЗ зоны, и значения
//   молча съезжают, если сессия БД не в UTC. (3) — миллисекунды, как у JS Date.
// - Строки с лимитом из спеки — varchar(n): основная проверка в DTO, а БД — последняя линия обороны.

enum UserRole {
  admin
  member

  @@map("user_role")
}

// Ограничения, которые Prisma не умеет описывать, добавлены SQL-ом в миграции *_add_users:
// - users_email_lowercase: CHECK (email = lower(email)).
model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  // Уникален без учёта регистра: сервис приводит email к trim + lower case и при регистрации,
  // и при входе, а CHECK в БД не даёт записать его в другом регистре в обход сервиса.
  email        String   @unique @db.VarChar(254)
  // Строка argon2id: соль и параметры хеширования хранятся внутри неё, отдельные колонки не нужны.
  passwordHash String   @map("password_hash")
  name         String   @db.VarChar(100)
  // Дефолт в БД: забытое поле при вставке создаст участника, а не админа.
  role         UserRole @default(member)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // Проставляет клиент Prisma при update(), а не БД: обновление сырым SQL его не изменит.
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions Session[]

  @@map("users")
}

// Одна строка на каждый выданный refresh-токен (spec.md, 3.2).
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  // CASCADE: сессия без пользователя бессмысленна.
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 от токена, сам токен не хранится: утёкший дамп БД не даёт войти.
  // Не argon2: токен — 32 случайных байта, перебор невозможен, а для поиска по
  // `WHERE token_hash = ...` хеш обязан быть детерминированным (без соли).
  tokenHash String    @unique @map("token_hash")
  // Общий для всех токенов, полученных ротацией от одного входа. Отдельной таблицы
  // у семьи нет: кроме id ей нечего хранить.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  // NULL — активна. Отозванную строку не удаляем: повторное предъявление её токена —
  // признак кражи, и его нужно отличить от просто неизвестного токена.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  // Postgres не создаёт индексы для FK сам. user_id — для каскадного удаления и будущего
  // «выйти со всех устройств», family_id — для отзыва всей семьи.
  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}
